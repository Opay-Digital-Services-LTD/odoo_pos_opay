<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="pos_opay.OPaySecretField">
        <div class="d-flex justify-content-between gap-1">
            <t t-if="props.readonly">
                <span t-if="state.isRevealed" t-out="displayedValue" class="text-break"/>
                <input
                    t-else=""
                    class="o_input border-0 py-0 o_disabled opacity-100"
                    type="password"
                    t-att-value="displayedValue ? 'a'.repeat(16) : ''"
                    readonly="readonly"
                />
            </t>
            <input
                t-else=""
                class="o_input"
                autocomplete="new-password"
                t-att-id="props.id"
                t-att-type="state.isRevealed ? 'text' : 'password'"
                t-att-placeholder="props.placeholder"
                t-ref="input"
            />
            <button
                type="button"
                class="btn fa flex-shrink-0"
                t-att-class="state.isRevealed ? 'fa-eye-slash' : 'fa-eye'"
                t-att-title="buttonTitle"
                t-on-click.stop="onToggleReveal"
            />
        </div>
    </t>
</templates>
